# Copy to .env in the working directory. Never commit real credentials.
# See configs/README.md. Empty required values fail validation.
APP_ENV=development
LOG_LEVEL=INFO
AUTH_MODE=external
# For signup/login set AUTH_MODE=local and mount/provide a private RSA/EC PEM key.
AUTH_PRIVATE_KEY_PATH=
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_SECONDS=2592000
AUTH_REQUESTS_PER_MINUTE=30
AUTH_INVITATION_SECONDS=86400
# Return invitation links once to the OWNER for local Swagger testing only.
AUTH_INVITATION_DEVELOPMENT_LINKS=false
AUTH_PUBLIC_BASE_URL=http://localhost:8000
# JWT issuer/audience; external mode also requires a trusted HTTPS JWKS URL.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_ALGORITHM=RS256
JWT_TENANT_ID_CLAIM=tenant_id
JWT_USER_ID_CLAIM=user_id
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=enterprise_rag
MONGODB_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=50
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=documents
MINIO_TIMEOUT_SECONDS=30
UPLOAD_MAX_BYTES=26214400
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
REDIS_URL=
RABBITMQ_URL=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
